        result.entities.forEach(r => {

            console.log({
                flowrunid: r.flowrunid,
                name: r.name,
                workflowname: r.workflowname,
                starttime: new Date(r.starttime).toLocaleString()
            });

        });

    },

    function(error) {
        console.log(error.message);
    }

);


