// Convert local time -> ISO UTC format
const startDateTime = new Date(localStart).toISOString();
const endDateTime = new Date(localEnd).toISOString();

console.log(startDateTime);
console.log(endDateTime);

const fetchXml =
  "?fetchXml=" +
  encodeURIComponent(`
    <fetch top='50'>
      <entity name='flowrun'>

        <attribute name='flowrunid' />
        <attribute name='name' />
        <attribute name='starttime' />
        <attribute name='workflowname' />

        <filter type='and'>

          <condition
            attribute='workflowid'
            operator='eq'
            value='${flowid}'
          />

          <condition
            attribute='starttime'
            operator='ge'
            value='${startDateTime}'
          />

          <condition
            attribute='starttime'
            operator='le'
            value='${endDateTime}'
          />

        </filter>

        <order attribute='starttime' descending='true' />

      </entity>
    </fetch>
  `);

window.top.Xrm.WebApi.retrieveMultipleRecords("flowrun", fetchXml).then(

